/* ========================================
   国控站群企业网站 - 主样式表
   Full Screen Snap Scrolling Enterprise Site
   ======================================== */

/* ========================================
   CSS 变量
   ======================================== */
:root {
    --color-primary: #166534;
    --color-gold: #C5A55A;
    --color-text-primary: #101215;
    --color-text-secondary: #6B7280;
    --color-bg-white: #FFFFFF;
    --color-bg-dark: #101215;
    --color-border: rgba(16, 18, 21, 0.1);
    --font-en: 'Altinn-DIN Condensed', sans-serif;
    --sidebar-width: 160px;
    --sidebar-width-collapsed: 80px;
    --section-title-font-size: 60px;
    --section-title-font-weight: 630;
}

/* ========================================
   SVG 图标样式
   ======================================== */
.svg-icon {
    width: 24px;
    height: 24px;
    fill: currentColor;
    flex-shrink: 0;
}

.svg-icon-sm {
    width: 24px;
    height: 24px;
}

.svg-icon-md {
    width: 28px;
    height: 28px;
}

.svg-icon-lg {
    width: 24px;
    height: 24px;
}

.svg-icon-white {
    fill: #FFFFFF;
}

.svg-icon-dark {
    fill: #101215;
}

/* ========================================
   重置 & 基础
   ======================================== */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    font-family: 'Noto Sans SC', 'MiSans', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text-primary);
    background: var(--color-bg-white);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

/* ========================================
   主容器 - 整页滚动
   ======================================== */
.main-container {
    overflow-y: scroll;
    height: 100vh;
    scroll-snap-type: y mandatory;
}

/* 隐藏滚动条 */
.main-container::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
}

.main-container {
    -ms-overflow-style: none;
    scrollbar-width: none;
}

/* ========================================
   搜索按钮
   ======================================== */
.search-btn {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1001;
    width: 60px;
    height: 60px;
    border-radius: 999px;
    background: #A8875C;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
}

.search-btn:hover {
    background: #8B6E48;
}

/* ========================================
   页面切换按钮 (Figma设计 1:1还原)
   ======================================== */
.page-switch-wrapper {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 1001;
    display: flex;
    flex-direction: row-reverse;
    align-items: center;
    height: 60px;
    background: rgba(16, 18, 21, 0.2);
    border-radius: 80px;
    padding: 0;
    transition: background 0.4s ease-in;
}

.page-switch-wrapper.expanded {
    background: rgba(16, 18, 21, 0.4);
    padding: 0 15px;
}

.page-switch-btn {
    width: 60px;
    height: 60px;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.3s ease-in;
}

.page-switch-btn svg {
    width: 24px;
    height: 24px;
}

.page-switch-wrapper.expanded .page-switch-btn {
    opacity: 0.5;
    pointer-events: none;
}

.page-switch-wrapper.expanded .page-switch-panel {
    display: flex;
    transition: opacity 0.3s ease-in;
}

.page-switch-panel {
    display: none;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;

    pointer-events: none;
    transition: opacity 0.3s ease-in;
}

.page-switch-wrapper.expanded .page-switch-panel {
    opacity: 1;
    pointer-events: auto;
}

.page-switch-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px;
    font-size: 16px;
    font-weight: 330;
    font-family: 'MiSans', 'Noto Sans SC', sans-serif;
    color: #FFFFFF;
    text-decoration: none;
    background: transparent;
    border: none;
    border-radius: 80px;
    transition: background 0.6s ease-in, border 0.3s ease-in;
    white-space: nowrap;
}

.page-switch-item:hover {
    background: rgba(255, 255, 255, 0.2);
}

.page-switch-item.active {
    background: rgba(255, 255, 255, 0.4);
}

/* ========================================
   侧边导航栏 (Sidebar)
   ======================================== */
.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: var(--sidebar-width);
    height: 100vh;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    background: none;
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                background 0.4s ease,
                border-color 0.4s ease;
    overflow: hidden;
}

/* 侧栏收缩状态 — 像素级还原Figma设计 */
.sidebar.collapsed {
    width: var(--sidebar-width-collapsed);
    background: none;
    border-right-color: rgba(255, 255, 255, 0.2);
}

.sidebar.collapsed .logo-full {
    display: none;
}

.sidebar.collapsed .logo-mini {
    display: block;
    width: 80px;
    height: 140px;
}

.sidebar.collapsed .sidebar-logo {
    padding: 0;
    height: 140px;
}

.sidebar.collapsed .sidebar-nav {
    gap: 24px;
    padding: 0;
}

.sidebar.collapsed .nav-item {
    padding: 0;
    min-height: 24px;
    background: none;
    border-radius: 0;
}

.sidebar.collapsed .nav-item.active {
    background: none;
}

.sidebar.collapsed .nav-item:hover {
    background: none;
}

.sidebar.collapsed .nav-text {
    display: none;
}

.sidebar.collapsed .nav-dot {
    display: block;
}

/* 收缩状态下 light 主题 */
.sidebar.collapsed.theme-light {
    background: none;
    border-right-color: rgba(255, 255, 255, 0.2);
}

/* 收缩状态下 dark 主题 */
.sidebar.collapsed.theme-dark {
    background: none;
    border-right-color: rgba(255, 255, 255, 0.2);
}

.sidebar-logo {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24px 0;
    flex-shrink: 0;
}

.logo-img {
    display: block;
}

.logo-full {
    width: auto;
    height: auto;
    max-width: 120px;
}

.logo-mini {
    display: none;
    width: 32px;
    height: 32px;
}

.sidebar-nav {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    /* gap: 6px; */
}

.nav-item {
    display: flex;
    padding: 24px 20px;
    justify-content: center;
    align-items: center;
    gap: 6px;
    font-size: 20px;
    font-weight: 400;
    color: #FFFFFF;
    text-decoration: none;
    transition: all 0.3s ease;
    border-radius: 2px;
    font-family: var(--font-en);
    text-align: center;
    cursor: pointer;
    position: relative;
}

.nav-item.active {
    background: rgba(197, 161, 113, 1);
    color: #FFFFFF;
}

.nav-item:hover {
    background: rgba(177, 0, 1, 1);
    color: #FFFFFF;
}

.nav-text {
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: 0.5px;
    white-space: nowrap;
    transition: opacity 0.3s ease;
}

/* 导航圆点指示器 */
.nav-dot {
    display: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(16, 18, 21, 0.3);
    flex-shrink: 0;
    transition: width 0.3s ease, height 0.3s ease, background 0.3s ease;
}

.nav-item.active .nav-dot {
    width: 24px;
    height: 24px;
    background: #C5A171;
}

.nav-item:hover .nav-dot {
    width: 24px;
    height: 24px;
    background: #B10001;
}

/* Collapsed nav dots for dark theme */
.theme-dark .nav-dot {
    background: rgba(255, 255, 255, 0.3);
}

.theme-dark .nav-item.active .nav-dot {
    width: 24px;
    height: 24px;
    background: #C5A171;
}

.theme-dark .nav-item:hover .nav-dot {
    width: 24px;
    height: 24px;
    background: #B10001;
}

/* Sidebar Theme - Light */
.sidebar.theme-light {
    border-right-color: var(--color-border);
}

.sidebar.theme-light .nav-item {
    color: var(--color-text-primary);
}

.sidebar.theme-light .nav-item.active,
.sidebar.theme-light .nav-item:hover {
    color: #FFFFFF;
}

/* Sidebar Theme - Dark (默认) */
.sidebar.theme-dark {
    border-right-color: rgba(255, 255, 255, 0.1);
}

.sidebar.theme-dark .nav-item {
    color: #FFFFFF;
}

/* ========================================
   页面区块通用 (Section)
   ======================================== */
.section {
    width: 100%;
    height: 100vh;
    min-height: 600px;
    position: relative;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
    opacity: 1;
    padding-left: 180px;
    scroll-snap-align: start;
    transition: padding-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.sidebar.collapsed ~ .main-container .section,
.section.sidebar-collapsed {
    padding-left: 100px;
}

.section-inner {
    width: 100%;
    max-width: none;
    padding: 8% 4% 6% 4%;
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
}

/* ========================================
   区块头部通用 (Section Header)
   ======================================== */
.section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 80px;
    width: 100%;
    flex-shrink: 0;
    min-height: 72px;
}

.section-title-wrap {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
}

.section-title {
    font-family: var(--font-en);
    font-size: var(--section-title-font-size);
    font-weight: var(--section-title-font-weight);
    color: var(--color-text-primary);
    line-height: 1.2;
}

.brand-icon {
    width: 45px;
    height: 45px;
    flex-shrink: 0;
}

/* More Link (查看更多按钮) */
.more-link {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    padding: 0;
    background: transparent;
    border-radius: 9999px;
    font-size: 20px;
    font-weight: 330;
    color: #6B7280;
    text-decoration: none;
    transition: color 0.3s ease;
    flex-shrink: 0;
}

.more-link:hover {
    color: #101215;
}

.more-link:hover .arrow-circle img {
    opacity: 1;
}

.arrow-circle {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3px;
}

.arrow-circle img {
    width: 24px;
    height: 22px;
    opacity: 0.5;
    transition: opacity 0.3s ease;
}

/* ========================================
   按钮通用 (Button)
   ======================================== */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 40px;
    font-size: 16px;
    font-weight: 500;
    font-family: 'Noto Sans SC', sans-serif;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    line-height: 1.2;
}

.btn-outline {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-text-primary);
}

.btn-outline:hover {
    background: var(--color-text-primary);
    color: #FFFFFF;
}

.btn-primary {
    background: var(--color-primary);
    color: #FFFFFF;
    border: 1px solid var(--color-primary);
}

.btn-primary:hover {
    background: #15803D;
}

/* ========================================
   首屏轮播 (Hero Section)
   ======================================== */
.hero-section {
    position: relative;
    padding: 0;
    padding-left: 180px;
    transition: padding-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.sidebar.collapsed ~ .main-container .hero-section,
.hero-section.sidebar-collapsed {
    padding-left: 100px;
}

.hero-slider {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

.hero-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.8s ease;
    z-index: 1;
}

.hero-slide.active {
    opacity: 1;
    z-index: 2;
}

.hero-slide-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1;
}

.hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
}

.hero-title {
    font-family: 'MiSans', var(--font-cn);
    color: #FFFFFF;
    line-height: 1.1;
}

.hero-subtitle {
    font-family: 'MiSans', var(--font-cn);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.5;
}

/* 农业类首屏专属样式 */
.agriculture-hero .hero-title {
    font-size: 100px;
    font-weight: 600;
    margin-bottom: 24px;
}

.agriculture-hero .hero-subtitle {
    font-size: 60px;
    font-weight: 300;
}

/* 科技类首屏专属样式 */
.technology-hero .hero-title {
    font-size: 100px;
    font-weight: 600;
    margin-bottom: 24px;
}

.technology-hero .hero-subtitle {
    margin-top:24px;
    font-size: 32px;
    font-weight: 330;
}

.technology-hero .hero-btn {
    display: inline-block;
    padding: 16px 64px;
    background: #1E40AF;
    color: #F9FAFB;
    font-family: 'MiSans', var(--font-cn);
    font-size: 30px;
    font-weight: 330;
    border-radius: 4px;
    text-decoration: none;
    margin-top:40px;
    transition: background 0.3s ease;
}

.technology-hero .hero-btn:hover {
    background: #1E40AF;
}

/* 金融类首屏专属样式 */
.finance-hero .hero-overlay {
    background: rgba(0, 0, 0, 0.2);
}

.finance-hero .hero-title {
    font-size: 120px;
    font-weight: 630;
    margin-bottom: 0;
}

.finance-hero .hero-subtitle {
    display: none;
}

/* 金融类企业简介专属样式 */
.finance-about-section {
    position: relative;
    background: #FFFFFF;
    /* padding: 160px 0 120px; */
}

.finance-about-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
}

.finance-about-bg img {
    position: absolute;
    bottom:0;
    left: 0;
    width: 100%;
    height: 1080px;
    object-fit: cover;
    opacity:0.6;
}


.finance-about-mask {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(217, 217, 217, 0) 24%, rgba(115, 115, 115, 0.0) 100%);
}

.finance-about-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 48px;
}

.finance-about-text {
    position: relative;
}

.finance-about-desc {
    font-family: MiSans, sans-serif;
    font-size: 20px;
    font-weight: 330;
    color: #111827;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: 64px;
}

.finance-about-desc.expanded {
    -webkit-line-clamp: unset;
    overflow: visible;
    text-overflow: unset;
}

.finance-about-more {
    color: #6E5636;
    cursor: pointer;
    display: inline-block;
    margin-top: 8px;
}

.finance-about-stats {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
    padding: 4% 0;
    background: transparent;
    border-radius: 6px;
}

.finance-stat-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
}

.finance-stat-value {
    display: flex;
    align-items: baseline;
    gap: 5px;
}

.finance-stat-num {
    font-family: 'Altinn-DIN Condensed', 'DINCondensed-Bold', sans-serif;
    font-size: 100px;
    font-weight: 700;
    color: #6E5636;
    line-height: 1;
}

.finance-stat-unit {
    font-family: MiSans, sans-serif;
    font-size: 30px;
    font-weight: 630;
    color: #6E5636;
}

.finance-stat-label {
    font-family: MiSans, sans-serif;
    font-size: 20px;
    font-weight: 330;
    color: #111827;
    margin: 0;
}

/* 金融类新闻动态专属样式 */
.finance-news-section {
    background: #FFFFFF;
    /* padding: 160px 0 120px; */
}

.finance-news-content {
    display: flex;
    gap: 40px;
    height: 472px;
}

.finance-news-focus {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    opacity: 0;
    transform: translateX(-80px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
}

.finance-news-focus-image {
    position: relative;
    flex: 1;
    border-radius: 6px;
    overflow: hidden;
}

.finance-news-focus-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.finance-news-focus-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(16, 18, 21, 0.2);
}

.finance-news-focus-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px;
    background: rgba(16, 18, 21, 0.5);
}

.finance-news-focus-title {
    font-family: MiSans, sans-serif;
    font-size: 20px;
    font-weight: 630;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.5;
}

.finance-news-focus-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 80px;
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(16, 18, 21, 0.2);
    cursor: pointer;
}

.finance-news-focus-nav-prev {
    left: 0;
}

.finance-news-focus-nav-next {
    right: 0;
}

.finance-news-focus-indicators {
    display: flex;
    justify-content: center;
    gap: 16px;
}

.finance-news-focus-indicator {
    width: 100%;
    max-width: 152px;
    height: 6px;
    background: #E1E8F2;
    border-radius: 3px;
    transition: background-color 0.3s ease;
}

.finance-news-focus-indicator.active {
    background: #B10001;
}

.finance-news-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 32px;
}

.finance-news-item {
    background: #FFFFFF;
    padding: 24px;
    display: flex;
    justify-content: space-between;
    align-items: top;
    gap: 40px;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out, box-shadow 0.3s ease-out;
    position:relative;
    cursor: pointer;
}

.finance-news-item:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease-in, box-shadow 0.3s ease-in;
}

.finance-news-item-title {
    font-family: MiSans, sans-serif;
    font-size: 20px;
    font-weight: 330;
    color: #111827;
    margin: 0;
    line-height: 1.4;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.finance-news-section.in-view .finance-news-focus {
    opacity: 1;
    transform: translateX(0);
    transition-timing-function: ease-in;
}

.finance-news-section.in-view .finance-news-item:nth-child(1) {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.1s;
    transition-timing-function: ease-in;
}

.finance-news-section.in-view .finance-news-item:nth-child(2) {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.2s;
    transition-timing-function: ease-in;
}

.finance-news-section.in-view .finance-news-item:nth-child(3) {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.3s;
    transition-timing-function: ease-in;
}

.finance-news-item-date {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    width: 60px;
}

.finance-news-item-month {
    font-family: 'Altinn-DIN Condensed', 'DINCondensed-Bold', sans-serif;
    font-size: 20px;
    font-weight: 400;
    color: #6B7280;
}

.finance-news-item-day {
    font-family: 'Altinn-DIN Condensed', 'DINCondensed-Bold', sans-serif;
    font-size: 60px;
    font-weight: 700;
    color: #111827;
    line-height: 1;
}

/* 金融类信息公开专属样式 */
.finance-info-section {
    background: #F2F9FF;
    /* padding: 160px 0 120px; */
}

.finance-info-list {
    display: flex;
    gap: 40px;
    height: 600px;
}

.finance-info-card {
    flex: 1;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    border-radius: 4px;
    overflow: hidden;
    opacity: 0;
    transform: translateY(60px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out, box-shadow 0.3s ease-out;
    max-height:540px;
    cursor: pointer;
}

.finance-info-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease-in, box-shadow 0.3s ease-in;
}

.finance-info-card-image {
    height: 308px;
    border-radius: 6px;
    overflow: hidden;
}

.finance-info-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.finance-info-card-content {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    flex: 1;
}

.finance-info-card-info {
    display: flex;
    gap: 40px;
}

.finance-info-card-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    width: 60px;
}

.finance-info-card-month {
    font-family: 'Altinn-DIN Condensed', 'DINCondensed-Bold', sans-serif;
    font-size: 20px;
    font-weight: 400;
    color: #6B7280;
}

.finance-info-card-day {
    font-family: 'Altinn-DIN Condensed', 'DINCondensed-Bold', sans-serif;
    font-size: 60px;
    font-weight: 700;
    color: #111827;
    line-height: 1;
}

.finance-info-card-title {
    font-family: MiSans, sans-serif;
    font-size: 20px;
    font-weight: 330;
    color: #111827;
    margin: 0;
    line-height: 1.4;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
}

.finance-info-card-more {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    color: #101215;
}

.finance-info-card-more span {
    font-family: MiSans, sans-serif;
    font-size: 16px;
    font-weight: 330;
    flex:1;
}

.finance-info-section.in-view .finance-info-card:nth-child(1) {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0s;
    transition-timing-function: ease-in;
}

.finance-info-section.in-view .finance-info-card:nth-child(2) {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.15s;
    transition-timing-function: ease-in;
}

.finance-info-section.in-view .finance-info-card:nth-child(3) {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.3s;
    transition-timing-function: ease-in;
}

/* Hero Controls */
.hero-controls {
    position: absolute;
    bottom: 120px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 24px;
}

.hero-nav {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.5);
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.hero-nav:hover {
    border-color: #FFFFFF;
    background: rgba(255, 255, 255, 0.1);
}

.hero-nav svg {
    width: 24px;
    height: 24px;
}

.hero-dots {
    display: flex;
    align-items: center;
    gap: 24px;
}

.dot {
    width: 84px;
    height: 4px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
    position: relative;
    cursor: pointer;
    overflow: hidden;
}

.dot-progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background: #FFFFFF;
    border-radius: 2px;
    transition: none;
}

/* ========================================
   走进企业 (About Section)
   ======================================== */
.about-section {
    background: var(--color-bg-white);
}

.tech-about-section {
    background: #F2F9FF;
}

.tech-about-section .about-content {
    flex-direction: row;
}

.tech-about-section .about-image {
    order: 1;
}

.tech-about-section .about-text {
    order: 2;
}

.about-content {
    display: flex;
    gap: 64px;
    align-items: stretch;
    flex: 1;
    min-height: 0;
}

.about-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
}

.about-desc {
    flex: 1;
    overflow: hidden;
    min-height: 0;
}

.about-desc-text {
    font-size: 20px;
    line-height: 1.6;
    color: var(--color-text-primary);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.text-green {
    color: var(--color-primary);
    white-space: nowrap;
}

.about-stats {
    display: flex;
    gap: 40px;
    padding: 15% 0;
    flex-shrink: 0;
}

.stat-item {
    text-align: left;
    flex:1;
}

.stat-value {
    display: flex;
    align-items: baseline;
    gap: 5px;
    margin-bottom: 8px;
}

.stat-num {
    font-family: 'Altinn-DIN Condensed', var(--font-en);
    font-size: 100px;
    font-weight: 700;
    color: #111827;
    line-height: 1;
}

.stat-unit {
    font-family: 'MiSans', var(--font-cn);
    font-size: 24px;
    font-weight: 600;
    color: #111827;
    white-space: nowrap;
}

.stat-label {
    font-family: 'MiSans', var(--font-cn);
    font-size: 20px;
    font-weight: 300;
    color: #6B7280;
    line-height: 1.4;
}

.about-buttons {
    display: flex;
    gap: 40px;
    flex-shrink: 0;
}

.about-buttons .btn {
    padding: 16px 64px;
    font-family: 'MiSans', var(--font-cn);
    font-size: 20px;
    font-weight: 330;
    border-radius: 4px;
    border-width: 1px;
    border-style: solid;
}

.about-buttons .btn-outline {
    background: transparent;
    color: #166534;
    border-color: #065F46;
}

.about-buttons .btn-outline:hover {
    background: #166534;
    color: #F9FAFB;
}

.about-buttons .btn-primary {
    background: #166534;
    color: #F9FAFB;
    border-color: rgba(16, 18, 21, 0.1);
}

.about-buttons .btn-primary:hover {
    background: #15803D;
}

.about-buttons .tech-btn-outline {
    background: #FFFFFF;
    color: #0B2291;
    border-color: #0B0058;
}

.about-buttons .tech-btn-outline:hover {
    background: #0B2291;
    color: #FFFFFF;
}

.about-buttons .tech-btn-primary {
    background: #1E40AF;
    color: #F9FAFB;
    border-color: #1E40AF;
}

.about-buttons .tech-btn-primary:hover {
    background: #1A3694;
}

.about-image {
    flex: 1;
    display: flex;
    align-items: stretch;
    justify-content: center;
    max-height: 880px;
}

.about-image img {
    width: 100%;
    height: 100%;
    border-radius: 8px;
    object-fit: cover;
}

/* ========================================
   新闻动态 (News Section)
   ======================================== */
.news-section {
    background: #ffffff;
    position: relative;
    overflow: hidden;
}

.news-bg {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 125%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
}

.news-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right bottom;
}

.news-section .section-inner {
    position: relative;
    z-index: 2;
}

.news-list {
    display: flex;
    gap: 40px;
    align-items: stretch;
    padding: 32px 0;
    background: transparent;
    /* flex: 1; */
}

.news-card {
    flex: 1;
    background: #FFFFFF;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    max-height:530px;
    border-radius:6px;
    overflow:hidden;
}

.news-image {
    width: 100%;
    height: 308px;
    overflow: hidden;
    border-radius: 4px;
}

.news-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    border-radius: 6px;
}

.news-card:hover .news-image img {
    transform: scale(1.05);
}

.news-body {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    flex: 1;
}

.news-meta {
    display: flex;
    gap: 40px;
    align-self: stretch;
}

.news-date-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    width: 60px;
    flex-shrink: 0;
}

.news-month {
    font-family: 'Altinn-DIN Condensed', var(--font-en);
    font-size: 20px;
    font-weight: 400;
    color: #6B7280;
    line-height: 1;
}

.news-day {
    font-family: 'Altinn-DIN Condensed', var(--font-en);
    font-size: 60px;
    font-weight: 700;
    color: #111827;
    line-height: 1;
}

.news-title {
    font-family: 'MiSans', var(--font-cn);
    font-size: 20px;
    font-weight: 330;
    line-height: 1.6;
    color: #111827;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
    align-self: stretch;
}

.news-more {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    font-family: 'MiSans', var(--font-cn);
    font-size: 16px;
    font-weight: 330;
    color: #111827;
    text-decoration: none;
    align-self: stretch;
    border-radius: 9999px;
    transition: gap 0.3s ease;
    flex:1;
}

.news-more span{
    flex:1;
}
.news-more svg {
    flex-shrink: 0;
}

.news-more:hover {
    gap: 20px;
}

/* ========================================
   媒体聚焦 (Media Section)
   ======================================== */
.media-section {
    position: relative;
}

.media-section .section-inner {
    position: relative;
    z-index: 999;
}

.tech-media-section {
    position: relative;
}

.tech-media-bg {
    position: absolute;
    left: 0;
    top: 0;
    width: 1920px;
    height: 1080px;
    pointer-events: none;
}

.tech-media-bg img {
    width: 100%;
    height: 100%;
}

.tech-media-section .media-body {
    flex-direction: row;
    gap: 64px;
}

.tech-media-section .media-list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 32px;
}

.tech-media-section .media-card {
    background: #FFFFFF;
    padding: 24px;
    display: flex;
    gap: 40px;
    align-items: flex-start;
    position:relative;
    cursor: pointer;
    transition: transform 0.3s ease-out, box-shadow 0.3s ease-out;
}

.tech-media-section .media-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease-in, box-shadow 0.3s ease-in;
}

.tech-media-section .media-card-date-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 60px;
}

.tech-media-section .media-card-month {
    font-family: 'Altinn-DIN Condensed', var(--font-en);
    font-size: 20px;
    color: #6B7280;
}

.tech-media-section .media-card-day {
    font-family: 'Altinn-DIN Condensed', var(--font-en);
    font-size: 60px;
    font-weight: 700;
    color: #111827;
}

.tech-media-section .media-card-text {
    flex: 1;
}

.tech-media-section .media-card-title {
    font-family: 'MiSans', var(--font-cn);
    font-size: 20px;
    font-weight: 400;
    color: #111827;
    line-height: 1.4;
    margin: 0;
}

.tech-media-section .media-carousel {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.tech-media-section .media-slider {
    position: relative;
    border-radius: 4px;
    overflow: hidden;
    height: 446px;
}

.tech-media-section .media-slider img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.tech-media-section .media-slider-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 85px;
    height: 85px;
    background: rgba(16, 18, 21, 0.2);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}

.tech-media-section .media-slider-prev {
    left: 0;
}

.tech-media-section .media-slider-next {
    right: 0;
}

.tech-media-section .media-slider-info {
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    background: rgba(16, 18, 21, 0.5);
    padding: 24px;
}

.tech-media-section .media-slider-caption {
    font-family: 'MiSans', var(--font-cn);
    font-size: 20px;
    font-weight: 630;
    color: #FFFFFF;
    margin: 0;
}

.tech-media-section .media-indicators {
    display: flex;
    justify-content: center;
    gap: 16px;
}

/* ========================================
   科技板块成果展示 (Tech Achievement Section)
   ======================================== */

.tech-achievement-section {
    position: relative;
    /* padding: 120px 0; */
    background: #F2F9FF;
}

.tech-achievement-bg {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.tech-achievement-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.tech-achievement-bg-mask {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(217, 217, 217, 0) 23%, rgba(115, 115, 115, 0.0) 100%);
}

.tech-achievement-section .section-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 80px;
}

.tech-achievement-list {
    display: flex;
    gap: 40px;
}

.tech-achievement-card {
    flex: 1;
    background: #FFFFFF;
    border-radius: 4px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.5s ease-in;
}

.tech-achievement-section.in-view .tech-achievement-card:nth-child(1) {
    opacity: 1;
    transition-delay: 0s;
    transition-timing-function: ease-in;
}

.tech-achievement-section.in-view .tech-achievement-card:nth-child(2) {
    opacity: 1;
    transition-delay: 0.15s;
    transition-timing-function: ease-in;
}

.tech-achievement-section.in-view .tech-achievement-card:nth-child(3) {
    opacity: 1;
    transition-delay: 0.3s;
    transition-timing-function: ease-in;
}

.tech-achievement-section.in-view .tech-achievement-card:nth-child(4) {
    opacity: 1;
    transition-delay: 0.45s;
    transition-timing-function: ease-in;
}

.tech-achievement-card:hover {
    transform: translateX(0) translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease-in, box-shadow 0.3s ease-in;
}

.tech-achievement-card:not(:hover) {
    transition: opacity 0.5s ease-in, transform 0.3s ease-out, box-shadow 0.3s ease-out;
}

.tech-achievement-image {
    height: 360px;
    overflow: hidden;
}

.tech-achievement-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.tech-achievement-body {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.tech-achievement-title {
    font-family: 'MiSans', var(--font-cn);
    font-size: 24px;
    font-weight: 630;
    color: #111827;
    margin: 0;
}

.tech-achievement-more {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 16px;
    text-decoration: none;
}

.tech-achievement-more span {
    flex:1;
    font-family: 'MiSans', var(--font-cn);
    font-size: 16px;
    font-weight: 330;
    color: #111827;
}

.tech-achievement-more .svg-icon {
    width: 24px;
    height: 24px;
}

.media-body {
    display: flex;
    gap: 64px;
    flex: 1;
}

.media-carousel {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.media-slider {
    position: relative;
    width: 100%;
    height: 80%;
    border-radius: 4px;
    overflow: hidden;
}

.media-slider img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
}

.media-slider-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px;
    background: rgba(16, 18, 21, 0.5);
    z-index: 2;
}

.media-slider-caption {
    font-family: 'MiSans', var(--font-cn);
    font-size: 20px;
    font-weight: 630;
    color: #FFFFFF;
    line-height: 1.5;
    transition: opacity 0.3s ease;
}

.media-slider-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 85px;
    height: 85px;
    border: none;
    background: rgba(16, 18, 21, 0.2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.media-slider-prev {
    left: 0;
}

.media-slider-next {
    right: 0;
}

.media-slider-nav:hover {
    background: rgba(16, 18, 21, 0.4);
}

.media-indicators {
    display: flex;
    gap: 16px;
    justify-content: center;
}

.media-indicator {
    flex: 1;
    height: 4px;
    background: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    transition: all 0.3s ease;
}

.media-indicator.active {
    background: #FFFFFF;
}

.media-list {
    flex:1;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
}

.media-card {
    display: flex;
    background: #FFFFFF;
    border-radius: 4px;
    cursor: pointer;
    transition: transform 0.3s ease-out, box-shadow 0.3s ease-out;
    max-height:220px;
    overflow: hidden;
}

.media-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease-in, box-shadow 0.3s ease-in;
}

.media-card-text {
    flex: 1;
    /* padding: 24px; */
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
}

.media-section .media-card-text {
    padding: 24px;
}

.media-card-title {
    flex:1;
    font-family: 'MiSans', var(--font-cn);
    font-size: 20px;
    font-weight: 330;
    color: #111827;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.media-card-meta {
    display: flex;
    align-items: center;
    gap: 2px;
}

.media-card-meta svg {
    flex-shrink: 0;
}

.media-card-date {
    font-family: 'Altinn-DIN Condensed', var(--font-en);
    font-size: 20px;
    font-weight: 400;
    color: #111827;
    line-height: 1;
    flex: 1;
}

.media-card-img {
    width: 366px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
}

.media-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 6px;
}

/* ========================================
   主营业务 (Business Section)
   ======================================== */
.business-section {
    position: relative;
    background: #F2F9FF;
}

.business-bg {
    position: absolute;
    left: -180px;
    width: calc(100% + 180px);
    bottom: 0;
    height: 590px;
    overflow: hidden;
    z-index: 0;
    transition: left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.sidebar.collapsed ~ .main-container .business-bg,
.business-bg.sidebar-collapsed {
    left: -100px;
}

.business-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.business-section .section-inner {
    position: relative;
    z-index: 2;
    gap: 80px;
}

.business-list {
    display: flex;
    gap: 40px;
    flex: 1;
    align-items: stretch;
    max-height: 480px;
}

.business-card {
    flex: 1;
    background: #ffffff57;
    border-radius: 4px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
    transition: background 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
                color 0.4s ease,
                transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.4s ease;
    position: relative;
}

.business-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
}

.business-card.active {
    transform: translateY(-6px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
    background: #65A30D;
}

.business-card[data-index="0"].active {
    background: #65A30D;
}

.business-card[data-index="1"].active {
    background: #166534;
}

.business-card[data-index="2"].active {
    background: #A8875C;
}

.business-card[data-index="3"].active {
    background: #8B6E48;
}

.business-card.active .business-name,
.business-card.active .business-desc,
.business-card.active .business-more-text,
.business-card.active .svg-icon {
    color: #FFFFFF;
}

.business-info {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.business-icon-wrap {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border-radius: 9999px;
    transition: background 0.3s ease;
}

.business-card.active .business-icon-wrap {
    background: rgba(255, 255, 255, 0.2);
}

.business-icon {
    width: 36px;
    height: 36px;
}

.business-card.active .business-icon {
    filter: brightness(0) invert(1);
}

.business-name {
    font-family: 'MiSans', var(--font-cn);
    font-size: 40px;
    font-weight: 630;
    color: #111827;
    text-align: left;
    transition: color 0.3s ease;
}

.business-desc {
    font-family: 'MiSans', var(--font-cn);
    font-size: 16px;
    font-weight: 330;
    line-height: 1.6;
    min-height: 42px;
    color: #6B7280;
    transition: color 0.3s ease;
}

.business-more-wrap {
    display: flex;
    align-items: flex-end;
    gap: 16px;
    padding: 24px 0 0;
    border-top: 1px solid rgba(16, 18, 21, 0.1);
    margin-top: auto;
}

.business-card.active .business-more-wrap {
    border-top-color: rgba(255, 255, 255, 0.1);
}

.business-more-text {
    font-family: 'MiSans', var(--font-cn);
    font-size: 16px;
    font-weight: 330;
    color: #111827;
    transition: color 0.3s ease;
    flex:1;
}

.business-card .svg-icon {
    color: #101215;
    transition: color 0.3s ease;
}

/* ========================================
   科技板块主营业务卡片 (Tech Business Cards)
   ======================================== */
.tech-business-section {
    background: #F2F9FF;
}

.tech-business-list {
    display: flex;
    justify-content: center;
    gap: 0;
    border-radius:6px;
    overflow:hidden;
}

.tech-business-card {
    position: relative;
    flex:1;
    height: 640px;
    overflow: hidden;
    cursor: pointer;
    background: #FFFFFF;
    opacity: 0;
    transform: scale(0.7);
    transition: z-index 0.3s ease-in, opacity 0.5s ease-out, transform 0.5s ease-out;
}

.tech-business-card:hover {
    transform: translateY(-12px);
    transition: transform 0.3s ease-in;
}

.tech-business-card:not(:hover) {
    transition: transform 0.5s ease-out;
}

.tech-business-card:last-child {
    margin-right: 0;
}

.tech-business-card-0 {
    z-index: 3;
}

.tech-business-card-1 {
    z-index: 2;
}

.tech-business-card-2 {
    z-index: 1;
}

.tech-business-section.in-view .tech-business-card-0 {
    opacity: 1;
    transform: scale(1);
    transition-delay: 0s;
    transition-timing-function: ease-in;
}

.tech-business-section.in-view .tech-business-card-1 {
    opacity: 1;
    transform: scale(1);
    transition-delay: 0.15s;
    transition-timing-function: ease-in;
}

.tech-business-section.in-view .tech-business-card-2 {
    opacity: 1;
    transform: scale(1);
    transition-delay: 0.3s;
    transition-timing-function: ease-in;
}

.tech-business-card.active {
    z-index: 4;
}

.tech-business-card:not(.active) {
    z-index: 1;
}

.tech-business-img-container {
    position: absolute;
    top: 0;
    left: 0;
    height: 640.82px;
    transition: opacity 0.3s ease-in;
}

.tech-business-card:not(.active) .tech-business-img-container {
    opacity: 0.6;
}

.tech-business-card.active .tech-business-img-container {
    opacity: 1;
}

.tech-business-card-0:not(.active) .tech-business-img-container {
    opacity: 0.6;
}

.tech-business-card-0.active .tech-business-img-container {
    opacity: 1;
}

.tech-business-img-container img {
    width: 100%;
    height:100%;
    object-fit: cover;
}

.tech-business-card-1 .tech-business-img-container img {
    width: 100%;
    height:100%;
    object-fit: cover;
}

.tech-business-card-2 .tech-business-img-container img {
    top: -20.44px;
    left: -81.3px;
    width: 682.59px;
    height: 682.59px;
}

.tech-business-img-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.2);
}

.tech-business-info-default {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px;
    opacity: 0;
    transition: opacity 0.3s ease-out;
}

.tech-business-card-0 .tech-business-info-default {
    background: linear-gradient(0deg, rgba(168, 135, 92, 1) 0%, rgba(168, 135, 92, 0) 100%);
}

.tech-business-card-1 .tech-business-info-default {
    background: linear-gradient(180deg, rgba(101, 163, 13, 0) 0%, rgba(22, 101, 52, 1) 100%);
}

.tech-business-card-2 .tech-business-info-default {
    background: linear-gradient(0deg, rgba(37, 99, 235, 1) 0%, rgba(37, 99, 235, 0) 100%);
}

.tech-business-card:not(.active) .tech-business-info-default {
    opacity: 1;
}

.tech-business-card.active .tech-business-info-default {
    opacity: 0;
}

.tech-business-info-active {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px;
    opacity: 0;
    transition: opacity 0.3s ease-in;
}

.tech-business-card-0 .tech-business-info-active {
    background: #A8875C;
}

.tech-business-card-1 .tech-business-info-active {
    background: #166534;
}

.tech-business-card-2 .tech-business-info-active {
    background: #1E40AF;
}

.tech-business-card.active .tech-business-info-active {
    opacity: 1;
}

.tech-business-card:not(.active) .tech-business-info-active {
    opacity: 0;
}

.tech-business-card-0.active .tech-business-info-active {
    opacity: 1;
}

.tech-business-title {
    font-family: MiSans, sans-serif;
    font-size: 30px;
    font-weight: 630;
    color: #FFFFFF;
    margin: 0;
}

.tech-business-desc {
    font-family: MiSans, sans-serif;
    font-size: 20px;
    font-weight: 330;
    color: #FFFFFF;
    line-height: 1.4;
    margin: 32px 0;
}

.tech-business-more {
    display: flex;
    align-items: center;
    gap: 16px;
}
.tech-business-more .svg{
    width:24px;
    height:24px;
}
.tech-business-more-text {
    font-family: MiSans, sans-serif;
    font-size: 16px;
    font-weight: 330;
    color: #FFFFFF;
    flex:1;
}

/* ========================================
   联系方式 (Contact Section)
   ======================================== */
.finance-business-section {
    position: relative;
    /* padding: 160px 0 120px; */
    min-height: 1080px;
}

.finance-business-bg {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.finance-business-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.finance-business-bg-mask {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(217, 217, 217, 0) 14%, rgba(115, 115, 115, 0.9) 100%);
}

.finance-business-section .section-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 80px;
}

.finance-business-list {
    display: flex;
    gap: 40px;
}

.finance-business-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 64px 40px;
    border-radius: 4px;
    background: rgba(16, 18, 21, 0.4);
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    cursor: pointer;
}

.finance-business-card[data-index="1"] {
    background: #C5A171;
}

.finance-business-card[data-index="2"] {
    background: #B10001;
}

.finance-business-section.in-view .finance-business-card {
    opacity: 1;
    transform: scale(1);
    transition-timing-function: ease-in;
}

.finance-business-card:hover {
    transform: translateY(-12px);
    transition: transform 0.3s ease-in;
}

.finance-business-section.in-view .finance-business-card[data-index="0"] {
    transition-delay: 0s;
}

.finance-business-section.in-view .finance-business-card[data-index="1"] {
    transition-delay: 0.15s;
}

.finance-business-section.in-view .finance-business-card[data-index="2"] {
    transition-delay: 0.3s;
}

.finance-business-section.in-view .finance-business-card[data-index="3"] {
    transition-delay: 0.45s;
}

.finance-business-icon-wrap {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 48px;
}

.finance-business-icon {
    max-width: 64px;
    max-height: 64px;
    fill: #FFFFFF;
}

.finance-business-name {
    font-family: 'MiSans', var(--font-cn);
    font-size: 30px;
    font-weight: 630;
    color: #FFFFFF;
    text-align: center;
    margin: 0 0 24px 0;
}

.finance-business-desc {
    font-family: 'MiSans', var(--font-cn);
    font-size: 20px;
    font-weight: 330;
    color: #FFFFFF;
    text-align: center;
    line-height: 1.5;
    margin: 0;
}

/* ========================================
   联系方式 (Contact)
   ======================================== */

.contact-section {
    background: var(--color-bg-white);
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    transition: padding-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.sidebar.collapsed ~ .main-container .contact-section,
.contact-section.sidebar-collapsed {
    padding-left: 0;
}

.contact-section .section-inner {
    position: relative;
    z-index: 2;
    gap: 80px;
}

.contact-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.contact-map img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.contact-map-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0) 100%);
    pointer-events: none;
}

.contact-popup {
    position: relative;
    z-index: 100;
    width: 880px;
    align-self: center;
}

.contact-card {
    position: relative;
    z-index: 3;
    background: var(--color-bg-white);
    border-radius: 4px;
    padding: 40px;
    width: 100%;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    overflow: visible;
}

.contact-logo {
    width: 381px;
    height: 60px;
    object-fit: contain;
    margin-bottom: 40px;
}

.contact-info {
    display: flex;
    flex-direction: column;
    gap: 40px;
}

.contact-row {
    display: flex;
    align-items: center;
    gap: 32px;
}

.contact-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex: 1;
}

.contact-label {
    font-size: 20px;
    font-weight: 330;
    color: var(--color-text-primary);
}

.contact-value {
    font-family: var(--font-en);
    font-size: 24px;
    font-weight: 700;
    color: var(--color-text-primary);
}

.contact-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
}

.contact-line {
    width: 100%;
    height: 1px;
    background: var(--color-border);
}

.contact-address {
    display: flex;
    align-items: center;
    gap: 8px;
}

.contact-location-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
}

.contact-dot {
    position: absolute;
    bottom: -60px;
    right: 45%;
    width: 96px;
    height: 96px;
}

.contact-arrow {
    position: absolute;
    bottom: px;
    right: 48.6%;
    width: 30px;
    height: 15px;
    z-index: 999;
}

/* ========================================
   底部品牌色条 (Brand Bar)
   ======================================== */
.brand-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    height: 16px;
}

.brand-red {
    flex: 1;
    background: #B10001;
}

.brand-gold {
    flex: 1;
    background: #C5A171;
}

/* ========================================
   文章列表页 (Article List Page)
   ======================================== */
.article-main {
    margin-left: var(--sidebar-width);
    min-height: 100vh;
    background: #FFFFFF;
    transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.sidebar.collapsed ~ .article-main {
    margin-left: var(--sidebar-width-collapsed);
}

/* 二级导航 Banner */
.article-banner {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
}

.banner-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.banner-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.banner-gradient {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, rgba(22, 101, 52, 0) 0%, rgba(44, 203, 105, 1) 100%);
}

.banner-content {
    position: relative;
    z-index: 2;
    height: 100%;
    padding: 0 60px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 16px;
}

/* 面包屑导航 */
.breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
}

.breadcrumb-home {
    width: 30px;
    height: 30px;
}

.breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 10px;
}

.breadcrumb-item {
    font-family: 'MiSans', 'Noto Sans SC', sans-serif;
    font-size: 16px;
    font-weight: 330;
    color: #111827;
}

.breadcrumb-item.active {
    font-family: 'MiSans', 'Noto Sans SC', sans-serif;
    font-size: 16px;
    font-weight: 630;
    color: #111827;
}

.breadcrumb-arrow {
    width: 16px;
    height: 16px;
}

/* 导航标签 */
.nav-tabs {
    display: flex;
    gap: 10px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(16, 18, 21, 0.1);
}

.nav-tab {
    padding: 24px 32px;
    font-family: 'MiSans', 'Noto Sans SC', sans-serif;
    font-size: 20px;
    font-weight: 330;
    color: #111827;
    background: transparent;
    border: none;
    cursor: pointer;
    border-bottom: 3px solid transparent;
    transition: all 0.3s ease;
}

.nav-tab:hover {
    color: #B10001;
}

.nav-tab.active {
    font-weight: 630;
    border-bottom-color: #B10001;
}

/* 文章列表区域 */
.article-section {
    padding: 64px 0;
}

.article-section .section-inner {
    max-width: 1560px;
    margin: 0 auto;
    padding: 0 60px;
    display: flex;
    flex-direction: column;
    gap: 64px;
}

/* 焦点轮播 */
.article-focus {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.focus-slider {
    position: relative;
    width: 100%;
    height: 560px;
    border-radius: 4px;
    overflow: hidden;
}

.focus-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease;
}

.focus-slide.active {
    opacity: 1;
}

.focus-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.focus-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(16, 18, 21, 0.2);
}

.focus-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 32px;
    background: rgba(16, 18, 21, 0.5);
    display: flex;
    gap: 40px;
}

.focus-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    width: 60px;
    flex-shrink: 0;
}

.focus-month {
    font-family: 'Altinn-DIN Condensed', sans-serif;
    font-size: 20px;
    font-weight: 400;
    color: #6B7280;
    line-height: 1;
}

.focus-day {
    font-family: 'Altinn-DIN Condensed', 'DINCondensed-Bold', sans-serif;
    font-size: 60px;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1;
}

.focus-title {
    font-family: 'MiSans', 'Noto Sans SC', sans-serif;
    font-size: 20px;
    font-weight: 330;
    color: #FFFFFF;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
    align-self: flex-start;
}

.focus-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 80px;
    height: 84px;
    background: rgba(16, 18, 21, 0.2);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s ease;
}

.focus-nav:hover {
    background: rgba(16, 18, 21, 0.4);
}

.focus-prev {
    left: 0;
}

.focus-next {
    right: 0;
}

.focus-indicators {
    display: flex;
    justify-content: center;
    gap: 16px;
}

.focus-indicator {
    width: 100%;
    max-width: 152px;
    height: 6px;
    background: #E1E8F2;
    border-radius: 3px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.focus-indicator.active {
    background: #B10001;
}

/* 文章列表 */
.article-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
}

.article-card {
    background: #FFFFFF;
    display: flex;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
}

.article-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease-in, box-shadow 0.3s ease-in;
}

.article-image {
    width: 460px;
    height: 308px;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 6px;
}

.article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
}

.article-card:hover .article-image img {
    transform: scale(1.05);
}

.article-body {
    flex: 1;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 32px;
}

.article-meta {
    display: flex;
    gap: 40px;
    align-items: flex-start;
}

.article-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    width: 60px;
    flex-shrink: 0;
}

.article-month {
    font-family: 'Altinn-DIN Condensed', sans-serif;
    font-size: 20px;
    font-weight: 400;
    color: #6B7280;
    line-height: 1;
}

.article-day {
    font-family: 'Altinn-DIN Condensed', 'DINCondensed-Bold', sans-serif;
    font-size: 60px;
    font-weight: 700;
    color: #111827;
    line-height: 1;
}

.article-title {
    font-family: 'MiSans', 'Noto Sans SC', sans-serif;
    font-size: 20px;
    font-weight: 330;
    color: #111827;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
    align-self: stretch;
}

.article-more {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    font-family: 'MiSans', 'Noto Sans SC', sans-serif;
    font-size: 16px;
    font-weight: 330;
    color: #111827;
    text-decoration: none;
    align-self: stretch;
    transition: gap 0.3s ease;
}

.article-more span {
    flex: 1;
    text-align: right;
}

.article-more:hover {
    gap: 20px;
}

/* 分页器 */
.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4px;
    padding: 32px 0;
}

.pagination-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background 0.3s ease;
    border-radius: 4px;
}

.pagination-btn:hover {
    background: rgba(16, 18, 21, 0.05);
}

.pagination-num {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Altinn-DIN Condensed', 'DINCondensed-Bold', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #111827;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease;
    border-radius: 4px;
}

.pagination-num:hover {
    background: rgba(16, 18, 21, 0.05);
}

.pagination-num.active {
    background: #166534;
    color: #FFFFFF;
}
